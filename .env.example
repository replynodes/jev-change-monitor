# jev-change-monitor environment — NAMES ONLY, NO REAL VALUES.
# Copy to `.env` for local demo runs and fill with your own values.
# The repository never reads credentials from files; it reads them from the
# process environment. Never commit a `.env` file with real values.

# Optional: Jev endpoint (live semantic evaluation path). If unset, the
# benchmark runs only deterministic schema/fixture validation and reports a
# machine-readable BLOCKED result for semantic thresholds.
# JEV_ENDPOINT=https://your-ai-gateway.example/v1/chat/completions
# JEV_API_KEY=change-me
# JEV_MODEL=jev-1.13.0

# Optional: run Jev via an explicit local command instead of HTTP.
# The command receives a JSON request on stdin and must return JSON on stdout.
# The value is never stored in or printed by results: artifacts record only a
# configured flag plus an allowlisted executable basename.
# JEV_COMMAND=/usr/local/bin/jev-judge

# Webhook demo — fixture secret ONLY. The example webhook sender/receiver
# treat this value as a labeled fixture; production secrets come from your own
# secrets manager and are never part of this repository.
# WEBHOOK_FIXTURE_SECRET=recipe-demo-fixture-secret-change-me