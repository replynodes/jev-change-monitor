{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/replynodes/jev-change-monitor/schemas/fixture-case.schema.json",
  "title": "FixtureCase",
  "description": "One labeled benchmark case. Fixtures are authored/synthetic or explicitly derived; they are never private or customer content.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "case_id", "detector", "split", "provenance", "provenance_detail",
    "subtype", "edge_case", "url", "label", "before", "after"
  ],
  "properties": {
    "case_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
    "detector": { "enum": ["price", "saas_pricing", "product_change"] },
    "split": { "enum": ["held_out", "dev"] },
    "provenance": { "enum": ["synthetic", "real_public", "derived"] },
    "provenance_detail": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "authored_by", "license", "permission"],
      "properties": {
        "kind": { "enum": ["synthetic", "real_public", "derived"] },
        "authored_by": { "type": "string", "minLength": 1 },
        "license": { "type": "string", "minLength": 1 },
        "permission": { "type": "string", "minLength": 1 },
        "source_url": { "type": ["string", "null"] },
        "retrieved_at": { "type": ["string", "null"] },
        "notes": { "type": ["string", "null"] }
      }
    },
    "subtype": { "type": "string", "minLength": 1 },
    "edge_case": { "type": "boolean" },
    "url": { "type": "string", "minLength": 1 },
    "label": {
      "type": "object",
      "additionalProperties": false,
      "required": ["meaningful", "should_alert", "rationale", "labeling"],
      "properties": {
        "meaningful": { "type": "boolean" },
        "should_alert": { "type": "boolean" },
        "rationale": { "type": "string", "minLength": 1 },
        "labeling": {
          "type": "object",
          "additionalProperties": false,
          "required": ["method", "labeler", "rubric_version", "review_status"],
          "properties": {
            "method": { "type": "string", "minLength": 1 },
            "labeler": { "type": "string", "minLength": 1 },
            "rubric_version": { "type": "string", "minLength": 1 },
            "review_status": { "type": "string", "minLength": 1 },
            "adjudication": { "type": ["string", "null"] },
            "notes": { "type": ["string", "null"] }
          }
        }
      }
    },
    "expected": {
      "type": "object",
      "description": "Detector-specific expectations and notes. The price block is structured; additional keys are free-form notes/extensions.",
      "properties": {
        "price": {
          "type": "object",
          "additionalProperties": false,
          "required": ["amount", "currency", "direction"],
          "properties": {
            "amount": { "type": ["number", "null"] },
            "currency": { "type": ["string", "null"] },
            "currency_before": { "type": ["string", "null"] },
            "amount_before": { "type": ["number", "null"] },
            "direction": { "enum": ["up", "down", "unchanged", "unknown"] },
            "period": { "type": ["string", "null"] },
            "note": { "type": ["string", "null"] }
          }
        },
        "saas_pricing": { "type": "object" },
        "product_change": { "type": "object" },
        "fixture_note": { "type": ["string", "null"] }
      }
    },
    "before": { "$ref": "#/definitions/snapshot" },
    "after": { "$ref": "#/definitions/snapshot" }
  },
  "definitions": {
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["content_type", "content", "captured_at"],
      "properties": {
        "content_type": { "enum": ["text/html", "text/normalized", "text/markdown", "text/plain"] },
        "content": { "type": "string", "maxLength": 200000 },
        "captured_at": { "type": "string", "minLength": 1 }
      }
    }
  }
}